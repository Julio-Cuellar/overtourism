                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuenta"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"  Ana   María Prueba \"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.7 Cerrar esta sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204 sin cuerpo', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sesion"
              ]
            }
          }
        },
        {
          "name": "1.8 El token cerrado ya no sirve",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401 NO_AUTENTICADO con Bearer en WWW-Authenticate', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().codigo).to.eql('NO_AUTENTICADO');",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "yo"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Errores de acceso",
      "description": "Cada error responde con un codigo y un texto fijos, sin trazas.",
