          "name": "2.2 Codigo incorrecto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function post(ruta, cuerpo, cb) { pm.sendRequest({ url: pm.variables.get('baseUrl') + ruta, method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(cuerpo) } }, cb); }",
                  "function codigoDe(tel, cb) { pm.sendRequest(pm.variables.get('baseUrl') + '/dev/canal/codigo?telefono=' + tel, function (e, r) { cb(r.json().codigo); }); }",
                  "function telefonoNuevo() { return '2229' + String(Math.floor(Math.random() * 1000000)).padStart(6, '0'); }",
                  "const tel = telefonoNuevo();",
                  "pm.collectionVariables.set('telefonoB', tel);",
                  "post('/auth/codigo', { telefono: tel }, function () {",
                  "  codigoDe(tel, function (c) { pm.collectionVariables.set('codigoMalo', c === '000000' ? '000001' : '000000'); });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', function () { pm.response.to.have.status(401); });",
