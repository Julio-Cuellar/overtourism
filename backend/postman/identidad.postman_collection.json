    {
      "name": "3. Sesiones",
      "description": "Cierre de todas las sesiones de una cuenta.",
      "item": [
        {
          "name": "3.1 Cerrar todas las sesiones",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function post(ruta, cuerpo, cb) { pm.sendRequest({ url: pm.variables.get('baseUrl') + ruta, method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify(cuerpo) } }, cb); }",
                  "function codigoDe(tel, cb) { pm.sendRequest(pm.variables.get('baseUrl') + '/dev/canal/codigo?telefono=' + tel, function (e, r) { cb(r.json().codigo); }); }",
                  "function telefonoNuevo() { return '2229' + String(Math.floor(Math.random() * 1000000)).padStart(6, '0'); }",
                  "const tel = telefonoNuevo();",
                  "function entrar(nombre, listo) {",
                  "  post('/auth/codigo', { telefono: tel }, function () {",
                  "    codigoDe(tel, function (c) {",
                  "      post('/auth/sesion', { telefono: tel, codigo: c, nombre: nombre }, function (e, r) { listo(r.json().token); });",
                  "    });",
                  "  });",
                  "}",
                  "entrar('Ana Prueba', function (a) { pm.collectionVariables.set('tokenA', a); entrar(null, function (b) { pm.collectionVariables.set('tokenB', b); }); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sesiones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sesiones"
              ]
            },
            "description": "Abre dos sesiones de la misma cuenta y cierra todas usando la primera."
          }
        },
        {
          "name": "3.2 La otra sesion tambien cayo",
          "event": [
