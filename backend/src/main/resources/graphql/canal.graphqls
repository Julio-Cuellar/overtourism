# Datos SIMULADOS para la demo: Catalogo y Pasaporte aun no existen (canal.demo). Todo lo de aqui va rotulado.

extend type Query {
  "Productos de ejemplo de una fonda y tienda poblana. Precios simulados."
  productosSimulados: [ProductoSimulado!]!
  "Cupones de ejemplo del Pasaporte. En la demo se pueden usar varias veces."
  cuponesSimulados: [CuponSimulado!]!
}

type ProductoSimulado {
  productoId: ID!
  descripcion: String!
  unidad: String!
  precio: Decimal!
  admiteFraccion: Boolean!
  "Siempre true: dato de demostracion, no de un negocio real."
  simulado: Boolean!
}

type CuponSimulado {
  codigo: String!
  descuento: Decimal!
  "Siempre true: dato de demostracion."
  simulado: Boolean!
}
