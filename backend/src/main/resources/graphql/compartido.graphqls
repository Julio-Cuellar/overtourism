# Piezas comunes de la plataforma. Cada modulo extiende Query en su propio archivo.

"Decimal exacto como cadena, por ejemplo \"207.00\". Nunca punto flotante."
scalar Decimal
"Fecha ISO-8601 sin hora."
scalar Date
"Fecha y hora ISO-8601 en UTC."
scalar DateTime

type Query

# El par prepararComando y confirmarComando es de la plataforma (D-55): cada modulo agrega variantes a ComandoInput.
type Mutation {
  prepararComando(input: ComandoInput!): Preparacion!
  confirmarComando(token: String!): Resultado!
}

type Preparacion {
  token: String!
  resumen: String!
  expiraEn: DateTime!
  advertencias: [String!]!
}

type Resultado {
  ok: Boolean!
  codigo: String!
  mensajePlantilla: String!
  recursoId: ID
  "Datos del resultado, por ejemplo folio, total y cambio de una venta. Ordenados por clave."
  datos: [Dato!]!
}

"Un dato con nombre de un resultado; el valor siempre es texto (el dinero como decimal exacto)."
type Dato {
  clave: String!
  valor: String!
}

type PageInfo {
  hayMas: Boolean!
  cursorFinal: String
}

# Lo que comparten Ventas, Caja y los verticales que cobren (D-136, D-130).

"Forma de pago. Es el mismo contrato en Ventas, Caja y cualquier vertical que lo muestre (D-136)."
enum MetodoPago { EFECTIVO TARJETA TRANSFERENCIA }

"Un monto por método de pago, con escala 2."
type MontoPorMetodo {
  metodo: MetodoPago!
  monto: Decimal!
}

input MontoPorMetodoInput {
  metodo: MetodoPago!
  monto: Decimal!
}
