# Esquema del modulo de Restaurantes (docs/diseno/restaurantes.md, R1: el menu). Sin negocioId en el panel: el negocio sale de la
# sesion (SG-02). La unica excepcion es menuPublico, la superficie publica del turista (D-170), que no tiene sesion y entrega
# solo los campos permitidos (PB-03). Los tipos llevan el prefijo Rest para no chocar con los de otros modulos (D-130).
# Las variantes de comando (guardarReceta, darDeBajaPlatillo) viajan por prepararComando y confirmarComando, el despachador de
# la plataforma (D-125, D-209); sus entradas estan al final de este archivo.

extend type Query {
  "Categorias activas del menu, por orden. Requiere restaurantes.menu.ver."
  categoriasDeMenu: [RestCategoria!]!
  "Platillos activos, por nombre, con filtros y cursor. primeros de 1 a 100. Requiere restaurantes.menu.ver."
  platillos(filtro: RestFiltroPlatillos, primeros: Int! = 20, despues: String): RestPlatilloConexion!
  platillo(id: ID!): RestPlatillo
  "Conteos del menu y cobertura de recetas."
  resumenDeMenu: RestResumenDeMenu!
  "La version vigente de la receta, o la ultima si se desactivo. Sin ninguna cifra de costo. Requiere restaurantes.receta.ver."
  receta(platilloId: ID!): RestReceta
  "Costo teorico y margen de la version vigente. Requiere restaurantes.costo.ver (RC-10)."
  costoDeReceta(platilloId: ID!): RestCostoReceta
  "Consumos de insumos que Inventario no pudo descontar, del mas nuevo al mas viejo. primeros de 1 a 100. Requiere restaurantes.consumo.ver."
  consumosFallidos(primeros: Int! = 20, despues: String): RestConsumoFallidoConexion!
  "Sin sesion. Nulo si el negocio no es un restaurante visible (publicado y activo)."
  menuPublico(negocioId: ID!, idioma: String = "es-MX"): RestMenuPublico
  "Sin sesion (QR-03). La mesa de un QR y si acepta pedidos; nulo si el token no sirve (inexistente, rotado, mesa dada de baja o negocio no visible). Nunca trae datos de la cuenta."
  mesaPorQr(token: String!): RestMesaPublica
  "Sin sesion (QR-11), para sondear cada ~10 s. Solo las lineas pedidas desde ese dispositivo y el estado de la cuenta; nulo si el token no sirve."
  estadoDePedidoQr(token: String!, dispositivoId: String!): RestEstadoPedidoQr
  "Todo el salon: servicio, disponibilidad, zonas y mesas con su estado derivado (MS-02). Requiere restaurantes.salon.ver."
  salon: RestSalon!
  "El enlace del QR de una mesa; el cliente dibuja el codigo (QR-21). Requiere restaurantes.salon.configurar."
  qrDeMesa(mesaId: ID!): String!

  "Una cuenta con sus lineas. Requiere restaurantes.cuenta.ver."
  cuenta(id: ID!): RestCuenta
  "Las cuentas abiertas o por cobrar de una mesa, o de todo el negocio si no se da mesa. Requiere restaurantes.cuenta.ver."
  cuentasAbiertas(mesaId: ID): [RestCuenta!]!
  "Lineas agregadas por platillo, total y referencia para cobrar con Ventas (CT-07). Solo una cuenta por cobrar. Requiere restaurantes.cuenta.ver."
  cuentaParaCobro(cuentaId: ID!): RestCuentaParaCobro!
  "El tablero, de la mas antigua a la mas nueva. Sin estados, las no entregadas. primeros de 1 a 100. Requiere restaurantes.comanda.ver."
  comandas(estacion: RestEstacion, estados: [RestEstadoDeComanda!], primeros: Int! = 50): [RestComanda!]!
}

extend type Mutation {
  "Sin sesion y con la cabecera Idempotency-Key obligatoria (QR-15, CT-14). Abre la cuenta si la mesa no tenia (QR-05) y va directo a cocina (QR-06). Limitada por token y por dispositivo (QR-16)."
  pedirPorQr(input: RestPedirPorQrInput!): RestResultadoPedidoQr!
  "Sin sesion (QR-13). La cuenta pasa a por cobrar y avisa a meseros y caja; despues el QR ya no acepta pedidos."
  pedirCuentaPorQr(token: String!, dispositivoId: String!): RestEstadoPedidoQr!
  crearCategoria(input: RestCategoriaInput!): RestCategoria!
  editarCategoria(id: ID!, version: Int!, input: RestCategoriaInput!): RestCategoria!
  crearPlatillo(input: RestPlatilloInput!): RestPlatillo!
  editarPlatillo(id: ID!, version: Int!, input: RestPlatilloInput!): RestPlatillo!
  "Requiere restaurantes.menu.agotar, que tambien tiene el cocinero."
  marcarAgotado(id: ID!, agotado: Boolean!): RestPlatillo!
  publicarPlatillo(id: ID!, publicar: Boolean!): RestPlatillo!
  "RECETA exige una receta activa; VINCULO_DIRECTO no admite una receta activa."
  cambiarModoDeInventario(id: ID!, modo: RestModoInventario!): RestPlatillo!
  "Cierra la version abierta de la receta. Falla si el platillo descuenta por receta. Requiere restaurantes.receta.editar."
  desactivarReceta(platilloId: ID!): RestReceta!

  "Requiere restaurantes.salon.configurar. Hasta 10 zonas (MS-01)."
  crearZona(nombre: String!, orden: Int! = 0): RestZona!
  "Falla si la zona tiene mesas activas (MS-07). Requiere restaurantes.salon.configurar."
  darDeBajaZona(id: ID!): Boolean!
  "Hasta 60 mesas; crea su QR (MS-01, QR-01). Requiere restaurantes.salon.configurar."
  crearMesa(input: RestMesaInput!): RestMesa!
  editarMesa(id: ID!, version: Int!, input: RestMesaInput!): RestMesa!
  "Falla si la mesa tiene una cuenta sin pagar (MS-07). Su QR deja de servir (MS-09)."
  darDeBajaMesa(id: ID!): Boolean!
  "Marca manual (MS-02). Requiere restaurantes.servicio.operar."
  bloquearMesa(id: ID!, bloquear: Boolean!): RestMesa!
  "Requiere restaurantes.servicio.operar (MS-05)."
  abrirServicio: RestDisponibilidad!
  "Con cuentas abiertas exige ademas restaurantes.linea.anular_preparada y un motivo (MS-05)."
  cerrarServicio(motivo: String): RestDisponibilidad!
  configurarModoDeServicio(modo: RestModoServicio!): RestModoServicio!
  "El token anterior deja de servir de inmediato (QR-02). Requiere restaurantes.salon.configurar."
  regenerarQrDeMesa(mesaId: ID!): String!
  "Pausa el QR de la mesa una hora, o lo reanuda (QR-17). Requiere restaurantes.servicio.operar."
  pausarQrDeMesa(mesaId: ID!, pausar: Boolean! = true): RestMesa!
  "Enciende o apaga los pedidos por QR de todo el local (QR-17). Requiere restaurantes.servicio.operar."
  habilitarQr(habilitado: Boolean!): Boolean!

  "Abre una cuenta de mesa o, en mostrador, sin mesa (CT-01). Requiere restaurantes.cuenta.abrir."
  abrirCuenta(input: RestAbrirCuentaInput!): RestCuenta!
  "Agrega una linea pendiente (CT-02). Requiere restaurantes.cuenta.abrir."
  agregarLinea(input: RestAgregarLineaInput!): RestCuenta!
  "Solo una linea que todavia no se envia (CT-03). Requiere restaurantes.cuenta.abrir."
  quitarLineaPendiente(cuentaId: ID!, lineaId: ID!): RestCuenta!
  "Una comanda por estacion con las lineas pendientes (CT-04). Requiere restaurantes.cuenta.abrir."
  enviarACocina(cuentaId: ID!): [RestComanda!]!
  "La cuenta pasa a por cobrar con los precios vigentes (CT-05). Requiere restaurantes.cuenta.abrir."
  pedirCuenta(cuentaId: ID!): RestCuenta!
  reabrirCuenta(cuentaId: ID!): RestCuenta!
  "Informativo: un mesero ya esta con la mesa (QR-08). Requiere restaurantes.cuenta.abrir."
  confirmarPresencia(cuentaId: ID!): RestCuenta!
  "Mientras su comanda no este lista (CT-03). Una ya lista va por prepararComando (anularLineaPreparada). Requiere restaurantes.linea.anular."
  anularLinea(input: RestAnularLineaInput!): RestCuenta!
  "Directa si ninguna linea llego a lista; si no, por prepararComando (cancelarCuentaPreparada) (CT-11). Requiere restaurantes.cuenta.cancelar."
  cancelarCuenta(cuentaId: ID!, motivo: RestMotivoDeAnulacion!, texto: String): RestCuenta!
  "Cierra una cuenta cobrada fuera del flujo, sin venta (CT-15). Requiere restaurantes.servicio.operar y restaurantes.linea.anular_preparada."
  liberarMesa(cuentaId: ID!, motivo: String!): RestCuenta!
  "Un paso a la vez; hasta lista pide restaurantes.comanda.preparar y a entregada, restaurantes.comanda.entregar (CD-02)."
  avanzarComanda(id: ID!): RestComanda!
  "De lista a en preparacion (CD-01). Requiere restaurantes.comanda.preparar."
  devolverComanda(id: ID!): RestComanda!
}

enum RestModoInventario { NINGUNO RECETA VINCULO_DIRECTO }
enum RestEstacion { COCINA BARRA }
enum RestEtiqueta {
  VEGETARIANO VEGANO SIN_GLUTEN SIN_LACTOSA SIN_FRUTOS_SECOS PICANTE TIPICO_POBLANO DE_TEMPORADA CONTIENE_ALCOHOL
}

type RestCategoria {
  id: ID!
  nombre: String!
  orden: Int!
  estacion: RestEstacion!
  activa: Boolean!
  version: Int!
}

type RestPlatillo {
  id: ID!
  nombre: String!
  descripcion: String
  precio: Decimal!
  categoriaId: ID
  modo: RestModoInventario!
  agotado: Boolean!
  "MM-dd, o nulo si es de todo el año."
  temporadaDesde: String
  temporadaHasta: String
  publicado: Boolean!
  activo: Boolean!
  etiquetas: [RestEtiqueta!]!
  tieneReceta: Boolean!
  "Activo, no agotado y en temporada hoy."
  ordenableHoy: Boolean!
  version: Int!
}

type RestPlatilloConexion {
  nodos: [RestPlatillo!]!
  "Cursor para la siguiente pagina, o nulo si no hay mas."
  siguiente: String
}

type RestResumenDeMenu {
  total: Int!
  agotados: Int!
  fueraDeTemporada: Int!
  conReceta: Int!
  sinReceta: Int!
  "Porcentaje de platillos con receta activa, con dos decimales."
  coberturaDeRecetasPct: Decimal!
}

input RestFiltroPlatillos {
  texto: String
  categoriaId: ID
  soloAgotados: Boolean = false
  soloFueraDeTemporada: Boolean = false
  soloSinReceta: Boolean = false
}

input RestPlatilloInput {
  nombre: String!
  descripcion: String
  precio: Decimal!
  categoriaId: ID
  etiquetas: [RestEtiqueta!] = []
  "MM-dd. Van juntas o no va ninguna."
  temporadaDesde: String
  temporadaHasta: String
}

input RestCategoriaInput {
  nombre: String!
  orden: Int! = 0
  estacion: RestEstacion
}

# ---------- Recetas (R2). Guardar una receta es el comando guardarReceta de prepararComando; llega con el despachador (D-125) ----------
type RestReceta {
  platilloId: ID!
  version: Int!
  "Porciones para las que estan escritas las cantidades."
  rendimiento: Int!
  activa: Boolean!
  vigenteDesde: DateTime!
  insumos: [RestInsumo!]!
}

type RestInsumo {
  articuloId: ID!
  "Nulo si el articulo ya no esta en Inventario."
  nombre: String
  cantidad: Decimal!
  unidad: String!
  "Desperdicio sobre lo neto, de 0 a 100."
  mermaPct: Decimal!
}

type RestCostoReceta {
  platilloId: ID!
  version: Int!
  rendimiento: Int!
  precio: Decimal!
  "Nulo si el costo es incompleto: nunca se estima."
  costoPorPorcion: Decimal
  margen: Decimal
  margenPct: Decimal
  incompleto: Boolean!
  insumosSinCosto: [ID!]!
  insumos: [RestCostoInsumo!]!
}

type RestCostoInsumo {
  articuloId: ID!
  nombre: String
  cantidadBase: Decimal
  unidadBase: String
  mermaPct: Decimal!
  cpp: Decimal
  "Costo del insumo en toda la receta, antes de repartirlo entre las porciones."
  costo: Decimal
}

# ---------- Consumo de insumos por venta (R3) ----------
type RestConsumoFallidoConexion {
  nodos: [RestConsumoFallido!]!
  siguiente: String
}

"Un consumo que Inventario no pudo descontar. No lleva datos de la venta ni de quien cobro (CM-08)."
type RestConsumoFallido {
  id: ID!
  ventaId: ID!
  "SIN_RECETA o el codigo de Inventario, por ejemplo ARTICULO_INACTIVO."
  codigo: String!
  "Texto fijo en español, segun el codigo."
  mensaje: String!
  lineas: [RestLineaFallida!]!
  ocurridoEn: DateTime!
  creadoEn: DateTime!
}

type RestLineaFallida {
  platilloId: ID!
  cantidad: Decimal!
}

# ---------- Superficie publica (PB-03): solo estos campos ----------
type RestMenuPublico {
  negocioId: ID!
  etiqueta: String!
  idioma: String!
  categorias: [RestCategoriaPublica!]!
  sinCategoria: [RestPlatilloPublico!]!
  actualizadoEn: DateTime!
  aviso: String!
}

type RestCategoriaPublica {
  id: ID!
  nombre: String!
  platillos: [RestPlatilloPublico!]!
}

type RestPlatilloPublico {
  id: ID!
  nombre: String!
  descripcion: String
  precio: Decimal!
  "Declaradas por el negocio, no verificadas."
  etiquetas: [RestEtiqueta!]!
  agotado: Boolean!
  "Falso si el texto esta en español porque no hay traduccion al idioma pedido."
  traducido: Boolean!
}

# ---------- Comandos (D-125, D-209): preparar -> confirmar con el par de la plataforma ----------
extend input ComandoInput {
  "Anula una linea ya lista o entregada, con merma (CT-03). Requiere restaurantes.linea.anular_preparada."
  anularLineaPreparada: RestAnularLineaPreparadaInput
  "Cancela una cuenta con platillos ya preparados (CT-11). Requiere restaurantes.linea.anular_preparada."
  cancelarCuentaPreparada: RestCancelarCuentaPreparadaInput
  "Guarda una version nueva de la receta de un platillo (RC-01, RC-08). Requiere restaurantes.receta.editar."
  guardarReceta: RestGuardarRecetaInput
  "Baja logica de un platillo (MN-10). Falla si esta en una cuenta abierta. Requiere restaurantes.menu.editar."
  darDeBajaPlatillo: RestBajaPlatilloInput
}

input RestGuardarRecetaInput {
  platilloId: ID!
  "Porciones para las que estan escritas las cantidades, de 1 a 500 (RC-04)."
  rendimiento: Int! = 1
  "De 1 a 30 insumos, sin repetir articulo (RC-02)."
  insumos: [RestRecetaInsumoInput!]!
}

input RestRecetaInsumoInput {
  articuloId: ID!
  cantidad: Decimal!
  "Se convierte a la unidad base del articulo con Inventario (UNIDAD_NO_CONVERTIBLE si no se puede)."
  unidad: String!
  "Desperdicio sobre lo neto, de 0 a 100 (D-167). Siempre se manda; 0 si no hay."
  mermaPct: Decimal!
}

input RestBajaPlatilloInput {
  platilloId: ID!
}

# ---------- Salon (R4): zonas, mesas, servicio y disponibilidad ----------
enum RestModoServicio { MESAS MOSTRADOR AMBOS }
"Derivado de la cuenta de la mesa; no se guarda (MS-02)."
enum RestEstadoDeMesa { LIBRE OCUPADA BLOQUEADA }
enum RestEstadoDeCuenta { ABIERTA POR_COBRAR PAGADA CANCELADA }

type RestZona {
  id: ID!
  nombre: String!
  orden: Int!
  activa: Boolean!
  version: Int!
}

type RestMesa {
  id: ID!
  zonaId: ID!
  etiqueta: String!
  capacidad: Int!
  estado: RestEstadoDeMesa!
  bloqueada: Boolean!
  "Verdadero si su QR no acepta pedidos en este momento (QR-17)."
  qrPausado: Boolean!
  version: Int!
  "La cuenta abierta o por cobrar de la mesa, o nulo."
  cuenta: RestResumenDeCuenta
}

type RestResumenDeCuenta {
  cuentaId: ID!
  numero: Int!
  estado: RestEstadoDeCuenta!
  total: Decimal!
  abiertaEn: DateTime!
  porQr: Boolean!
  presenciaConfirmada: Boolean!
}

"Mesas libres de un restaurante (MS-04); lo que ve el turista."
type RestDisponibilidad {
  libres: Int!
  total: Int!
  abierto: Boolean!
}

type RestSalon {
  servicioAbierto: Boolean!
  qrHabilitado: Boolean!
  modo: RestModoServicio!
  disponibilidad: RestDisponibilidad!
  zonas: [RestZona!]!
  mesas: [RestMesa!]!
}

input RestMesaInput {
  zonaId: ID!
  "De 1 a 20 caracteres, unica entre las mesas activas del negocio."
  etiqueta: String!
  "De 1 a 20 personas."
  capacidad: Int!
}

# ---------- Cuentas, lineas y comandas (R5) ----------
enum RestOrigenDeCuenta { PERSONAL QR }
enum RestEstadoDeLinea { PENDIENTE ENVIADA ANULADA }
enum RestEstadoDeComanda { NUEVA EN_PREPARACION LISTA ENTREGADA }
"Por que se anula una linea o se cancela una cuenta (QR-10). OTRO pide texto de hasta 80 caracteres."
enum RestMotivoDeAnulacion { AGOTADO ERROR_DEL_PEDIDO SIN_COMENSALES COCINA_NO_PUEDE OTRO }

type RestLinea {
  id: ID!
  platilloId: ID!
  nombre: String!
  cantidad: Int!
  precio: Decimal!
  subtotal: Decimal!
  nota: String
  marcaAlergia: Boolean!
  estado: RestEstadoDeLinea!
  estacion: RestEstacion!
  "Como va en su estacion, o nulo si todavia no se envia."
  estadoDeComanda: RestEstadoDeComanda
  motivo: RestMotivoDeAnulacion
  "El texto fijo que ve el comensal, por ejemplo: Cancelado: agotado."
  mensajeDelMotivo: String
  anuladaEn: DateTime
}

type RestCuenta {
  id: ID!
  numero: Int!
  mesaId: ID
  "El nombre de la mesa, o Mostrador."
  mesa: String!
  estado: RestEstadoDeCuenta!
  origen: RestOrigenDeCuenta!
  comensales: Int
  abiertaEn: DateTime!
  solicitadaEn: DateTime
  presenciaConfirmada: Boolean!
  total: Decimal!
  discrepancia: Boolean!
  ventaAnulada: Boolean!
  ventaId: ID
  lineas: [RestLinea!]!
  version: Int!
}

type RestLineaDeComanda {
  lineaId: ID!
  platillo: String!
  cantidad: Int!
  nota: String
  "Se resalta en el tablero; no guarda detalle medico (CD-06)."
  marcaAlergia: Boolean!
  "Tachada en el tablero (CD-05)."
  anulada: Boolean!
}

type RestComanda {
  id: ID!
  envioId: ID!
  cuentaId: ID!
  numeroDeCuenta: Int!
  mesa: String!
  estacion: RestEstacion!
  estado: RestEstadoDeComanda!
  enviadaEn: DateTime!
  listaEn: DateTime
  "Calculado por el servidor (CD-04); nulo si aun no esta lista."
  segundosDePreparacion: Int
  "Lleva mas de 15 minutos sin estar lista."
  retrasada: Boolean!
  lineas: [RestLineaDeComanda!]!
  version: Int!
}

type RestCuentaParaCobro {
  cuentaId: ID!
  "Se manda a Ventas al cobrar: restaurantes:cuenta:<id>."
  referencia: String!
  total: Decimal!
  lineas: [RestLineaDeCobro!]!
}

type RestLineaDeCobro {
  productoId: ID!
  descripcion: String!
  cantidad: Int!
}

input RestAbrirCuentaInput {
  "Nulo en mostrador."
  mesaId: ID
  "De 1 a 50."
  comensales: Int!
}

input RestAgregarLineaInput {
  cuentaId: ID!
  platilloId: ID!
  "Entero de 1 a 99."
  cantidad: Int!
  "Hasta 80 caracteres."
  nota: String
  marcaAlergia: Boolean! = false
}

input RestAnularLineaInput {
  lineaId: ID!
  motivo: RestMotivoDeAnulacion!
  "Solo con OTRO, hasta 80 caracteres."
  texto: String
}

input RestAnularLineaPreparadaInput {
  lineaId: ID!
  motivo: RestMotivoDeAnulacion!
  texto: String
}

input RestCancelarCuentaPreparadaInput {
  cuentaId: ID!
  motivo: RestMotivoDeAnulacion!
  texto: String
}

# ---- Pedido del comensal por QR (R6, QR-03 a QR-20). Sin sesion: el negocio sale de la mesa del token. ----

enum RestEstadoPublicoDeCuenta { SIN_CUENTA ABIERTA SOLICITADA }
enum RestEstadoDeLineaQr { EN_COCINA PREPARANDO LISTO ENTREGADO CANCELADO }

"Lo unico que el comensal sabe de la mesa (QR-03). El nombre del negocio lo da negocioPublico con negocioId."
type RestMesaPublica {
  negocioId: ID!
  mesa: String!
  servicioAbierto: Boolean!
  aceptaPedidos: Boolean!
  estadoCuenta: RestEstadoPublicoDeCuenta!
}

"Una linea que pidio este dispositivo. mensaje es el texto fijo del motivo si se cancelo (QR-10)."
type RestLineaDePedidoQr {
  id: ID!
  platillo: String!
  cantidad: Int!
  estado: RestEstadoDeLineaQr!
  mensaje: String
}

type RestEstadoPedidoQr {
  cuenta: RestEstadoPublicoDeCuenta!
  lineas: [RestLineaDePedidoQr!]!
}

type RestResultadoPedidoQr {
  abrioLaCuenta: Boolean!
  estado: RestEstadoPedidoQr!
}

"dispositivoId: un identificador al azar que guarda el navegador; el servidor guarda solo su hash (QR-12). Hasta 20 lineas."
input RestPedirPorQrInput {
  token: String!
  dispositivoId: String!
  lineas: [RestPedidoPorQrLineaInput!]!
}

"cantidad de 1 a 10; nota de hasta 80 caracteres."
input RestPedidoPorQrLineaInput {
  platilloId: ID!
  cantidad: Int!
  nota: String
  marcaAlergia: Boolean! = false
}

# ---- Avisos en vivo del personal (8.4). Atajos: la pantalla se corrige con las consultas comandas y salon. ----

extend type Subscription {
  "Cada comanda enviada o actualizada del negocio, de las dos estaciones o de la que se pida. Requiere restaurantes.comanda.ver. Respaldo: comandas."
  comandasDeCocina(estacion: RestEstacion): RestAvisoDeComanda!
  "Pedidos por QR, cuentas pedidas, mesas libres y, para quien opera el servicio, la pausa de un QR. Requiere restaurantes.salon.ver. Respaldo: salon."
  salonActualizado: RestAvisoDelSalon!
}

enum RestTipoDeAvisoDeComanda { ENVIADA ACTUALIZADA }
enum RestTipoDeAvisoDelSalon { PEDIDO_QR CUENTA_SOLICITADA DISPONIBILIDAD QR_PAUSADO DISCREPANCIA }

"mesa, numeroDeCuenta y lineas solo vienen en ENVIADA; lineasAnuladas solo en ACTUALIZADA."
type RestAvisoDeComanda {
  tipo: RestTipoDeAvisoDeComanda!
  comandaId: ID!
  estacion: RestEstacion!
  "NUEVA si es recien enviada; el estado nuevo si es una actualizacion."
  estado: RestEstadoDeComanda!
  numeroDeCuenta: Int
  mesa: String
  lineas: [RestLineaDeAviso!]!
  lineasAnuladas: [ID!]!
}

type RestLineaDeAviso {
  platillo: String!
  cantidad: Int!
  nota: String
  marcaAlergia: Boolean!
}

"Cada tipo llena solo sus campos: PEDIDO_QR (mesa, cuentaId, lineas, abrioLaCuenta), CUENTA_SOLICITADA (mesa, cuentaId, solicitadaPor), DISPONIBILIDAD (libres, total, abierto), QR_PAUSADO (mesa, hasta), DISCREPANCIA (mesa, cuentaId: la cuenta se pago con una venta que no vendio lo mismo, CT-08)."
type RestAvisoDelSalon {
  tipo: RestTipoDeAvisoDelSalon!
  mesa: String
  cuentaId: ID
  lineas: Int
  abrioLaCuenta: Boolean
  solicitadaPor: String
  libres: Int
  total: Int
  abierto: Boolean
  hasta: DateTime
}
